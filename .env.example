# Neon PostgreSQL — this project uses its OWN dedicated database.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/earnerskins?sslmode=require"

# Session signing secret (generate a long random string).
AUTH_SECRET="replace-with-a-long-random-secret"

# SMTP for transactional email (registration, password reset, order confirmation).
SMTP_HOST="mail.privateemail.com"
SMTP_PORT="587"
SMTP_USER="info@earnerskins.com"
SMTP_PASSWORD=""
SMTP_FROM="EarnerSkins <info@earnerskins.com>"

# Public site URL (used for canonical URLs, emails, sitemap).
NEXT_PUBLIC_SITE_URL="https://earnerskins.com"
